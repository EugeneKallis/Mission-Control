# Mission Control — Environment
# Copy to .env and fill in your values

DATABASE_URL="file:./prisma/dev.db"
WEB_PORT=8080

# Media paths
RCLONE_PATH="/mnt/addons/debrid/__all__"
MEDIA_BASE_PATH="/mnt/debrid/media/"
MEDIA_DIRECTORIES="movies,movies4k,moviesanime,movieskids,movieslocal,special,tv,tv4k,tvanime,tvkids,tvlocal"

# External Services
DECYPHARR_URL="http://192.168.1.99:8282"
REAL_DEBRID_API_KEY=
PULSE_API_KEY=

# Plex
PLEX_TOKEN=
PLEX_URL=
PLEX_WATCHLIST_RSS=

# Trakt
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Arr API keys — uncomment and set to override defaults
# ARR__RADARR__API_KEY="replace-with-radarr-api-key"
# ARR__RADARR4K__API_KEY="replace-with-radarr4k-api-key"
# ARR__RADARRKIDS__API_KEY="replace-with-radarrkids-api-key"
# ARR__RADARRANIME__API_KEY="replace-with-radarranime-api-key"
# ARR__RADARRLOCAL__API_KEY="replace-with-radarrlocal-api-key"
# ARR__SONARR__API_KEY="replace-with-sonarr-api-key"
# ARR__SONARR4K__API_KEY="replace-with-sonarr4k-api-key"
# ARR__SONARRKIDS__API_KEY="replace-with-sonarrkids-api-key"
# ARR__SONARRANIME__API_KEY="replace-with-sonarranime-api-key"
# ARR__SONARRLOCAL__API_KEY="replace-with-sonarrlocal-api-key"

# Arr instance URLs — uncomment and set to override defaults and Config page values
# ARR__RADARR__URL="http://192.168.1.111:7878"
# ARR__RADARR4K__URL="http://192.168.1.111:7879"
